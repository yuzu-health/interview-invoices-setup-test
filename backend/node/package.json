{
  "name": "preflight-backend-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "seed": "DATABASE_URL=file:./dev.db prisma migrate deploy && tsx prisma/seed.ts",
