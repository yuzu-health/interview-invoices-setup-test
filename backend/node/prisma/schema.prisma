generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Widget {
  id        Int      @id @default(autoincrement())
  name      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
}
